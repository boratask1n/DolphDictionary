rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny all unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. User Validation Helper
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256;
    }

    // 4. Word Validation Helper
    function isValidWord(data) {
      return data.keys().hasAll(['id', 'userId', 'word', 'language', 'partOfSpeech', 'meanings', 'dateAdded', 'nextReviewDate'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.word is string && data.word.size() > 0 && data.word.size() <= 128
        && (data.language == 'en' || data.language == 'de')
        && data.partOfSpeech is string && data.partOfSpeech.size() <= 32
        && data.meanings is list
        && data.dateAdded is string && data.dateAdded.size() <= 64
        && data.nextReviewDate is string && data.nextReviewDate.size() <= 64
        && (!('difficultyRating' in data) || (data.difficultyRating is number && data.difficultyRating >= 1.0 && data.difficultyRating <= 10.0))
        && (!('personalNote' in data) || (data.personalNote is string && data.personalNote.size() <= 2048));
    }

    // 5. ReviewLog Validation Helper
    function isValidReviewLog(data) {
      return data.keys().hasAll(['id', 'userId', 'wordId', 'wordText', 'timestamp', 'feedback'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.wordId is string && data.wordId.size() <= 128
        && data.wordText is string && data.wordText.size() <= 128
        && data.timestamp is string && data.timestamp.size() <= 64
        && data.feedback is string && data.feedback.size() <= 32;
    }

    // 6. User Profile Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user listing is strictly forbidden
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid;
      allow delete: if isOwner(userId);

      // 7. Words Subcollection
      match /words/{wordId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(wordId)
          && isValidWord(incoming())
          && incoming().userId == request.auth.uid;
        allow update: if isOwner(userId)
          && isValidId(wordId)
          && isValidWord(incoming())
          && incoming().userId == existing().userId
          && incoming().id == existing().id
          && incoming().dateAdded == existing().dateAdded;
        allow delete: if isOwner(userId) && isValidId(wordId);
      }

      // 8. Review Logs Subcollection (Immutable Logs)
      match /reviewLogs/{logId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(logId)
          && isValidReviewLog(incoming())
          && incoming().userId == request.auth.uid;
        allow update: if false; // Immutable audit logs
        allow delete: if isOwner(userId) && isValidId(logId);
      }

      // 9. User Settings Subcollection
      match /settings/{settingId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(settingId)
          && incoming().userId == request.auth.uid;
        allow delete: if isOwner(userId) && isValidId(settingId);
      }
    }
  }
}
